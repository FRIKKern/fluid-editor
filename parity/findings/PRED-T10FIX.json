      "text": "# a\nb\n# d",
      "type": "Q at the end",
      "expect": "the typed letters go, the fold stays"
    },
    "U2 Bold on a word above a fold, Meta+Z": {
      "text": "w\n# a\nb\n# d",
      "expect": "the word back, the fold stays"
